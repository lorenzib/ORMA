rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isModerator() {
      return request.auth != null && request.auth.token.moderator == true;
    }

    match /backoffice/trail-images/{trailId}/{fileName} {
      allow read: if isModerator();
      allow create: if isModerator()
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)')
        && request.resource.metadata.trailId == trailId
        && request.resource.metadata.uploadedBy == request.auth.uid
        && request.resource.metadata.rightsBasis in ['orma-owned', 'permission-granted'];
      allow update: if false;
      allow delete: if isModerator();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
