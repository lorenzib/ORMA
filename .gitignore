# No trailing slash: with one, this matches a directory only, so a symlinked
# node_modules in a git worktree stays untracked-but-visible and can be swept
# into a commit by a bare `git add -A`.
node_modules
firestore-debug.log
firebase-debug.log
ui-debug.log
.cache/
*service-account*.json
firebase-adminsdk*.json
.firebase/
dist/
backoffice-data/image-library-config.local.json
_site/

# Dev-server preview configs. Every entry is an absolute path on one machine --
# a checkout, a Downloads folder, a session scratchpad that is deleted when the
# session ends -- so the file is meaningless anywhere else, and every agent
# session that starts a preview server appends to it. Tracking it guaranteed a
# permanently dirty tree; the tooling recreates it wherever it is needed.
.claude/launch.json
