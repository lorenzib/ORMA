{
  "name": "dolopaws",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:static": "node scripts/check-static-assets.js",
    "audit:trail-trust": "node scripts/audit-trail-trust.js",
    "fetch:amenities": "node scripts/fetch-amenities.js",
    "fetch:dolomites-trails": "node scripts/fetch-dolomites-trails.js",
    "validate:dolomites-trails": "node scripts/validate-dolomites-trails.js",
    "validate:trail-schema": "node scripts/validate-trail-schema.js",
    "validate:alpine-plants": "node scripts/validate-alpine-plants.js",
    "validate:production-trails": "node scripts/validate-production-trails.js --report data/generated/trail-validation-report.json",
    "validate:production-trails:check": "node scripts/validate-production-trails.js",
    "validate:scoring-contract": "jest --runInBand scoring-contract.test.js",
    "validate:evidence-contract": "jest --runInBand evidence-contract.test.js",
    "validate:firestore-contract": "jest --runInBand firestore-security.test.js",
    "test:firestore-rules": "node scripts/run-firestore-rules-tests.cjs",
    "perf:mobile": "node scripts/run-mobile-performance.mjs --check",
    "perf:mobile:baseline": "node scripts/run-mobile-performance.mjs --write-baseline",
    "check:beta-readiness": "node scripts/check-beta-readiness.js",
    "check:i18n": "node scripts/check-i18n-parity.js",
    "check:trail-sources": "node scripts/check-trail-sources.js",
    "build:regional-data": "node scripts/build-regional-runtime-data.js",
    "generate:artifacts": "npm run validate:production-trails && node scripts/generate-trail-pages.js && npm run build:regional-data",
    "check:generated": "node scripts/check-generated-artifacts.js",
    "quality:gate": "node scripts/run-quality-gate.js",
    "build:dolomites-trails": "npm run fetch:dolomites-trails && npm run validate:dolomites-trails",
    "test:backoffice": "jest --runInBand backoffice/backoffice.test.js",
    "backoffice:discover": "node backoffice/cli/discover.js",
    "backoffice:logistics": "node backoffice/cli/logistics.js",
    "backoffice:cartographer": "node backoffice/cli/cartographer.js",
    "backoffice:campaign": "node backoffice/cli/campaign.js",
    "backoffice:run-campaign": "node backoffice/cli/run-campaign.js",
    "backoffice:content-flow": "node backoffice/cli/content-flow.js",
    "backoffice:verified-editorial": "node backoffice/cli/verified-editorial.js",
    "backoffice:seed-verified-editorial": "node backoffice/cli/seed-verified-editorial.js",
    "backoffice:publication-staging": "node backoffice/cli/publication-staging.js",
    "backoffice:content-ops": "node backoffice/cli/content-operations.js",
    "backoffice:run-content-ops": "node backoffice/cli/run-content-ops.js",
    "backoffice:product-discovery": "node backoffice/cli/product-discovery.js",
    "backoffice:image-coverage": "node backoffice/cli/image-coverage.js",
    "backoffice:strategy-cycle": "node backoffice/cli/strategy-cycle.js",
    "backoffice:hazard-watch": "node backoffice/cli/hazard-watch.js",
    "backoffice:new-trail-scouting": "node backoffice/cli/new-trail-scouting.js",
    "backoffice:new-trail-intake": "node backoffice/cli/admit-new-trail-intake.js",
    "backoffice:build-route-proposals": "node scripts/build-route-proposals.js",
    "backoffice:review": "node scripts/serve-backoffice.js",
    "backoffice:worker:live": "node backoffice/cli/live-worker.js",
    "backoffice:worker:health": "node backoffice/cli/record-worker-health.js",
    "backoffice:seed:live": "node backoffice/cli/seed-live-state.js",
    "backoffice:materialize-publications": "node backoffice/cli/materialize-publications.js",
    "backoffice:record-publication-failure": "node backoffice/cli/record-publication-failure.js",
    "backoffice:acknowledge-publications": "node backoffice/cli/acknowledge-publications.js",
    "backoffice:orchestration:build": "node backoffice/cli/build-live-orchestration.js",
    "backoffice:campaign:live": "node backoffice/cli/start-live-trail-campaign.js",
    "build:backoffice-hosting": "node scripts/build-backoffice-hosting.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0",
    "firebase-admin": "^14.2.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "puppeteer": "24.16.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/*.test.js"
    ]
  },
  "allowScripts": {
    "puppeteer@24.16.0": true
  }
}
