{
  "name": "dolopaws",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:static": "node scripts/check-static-assets.js",
    "audit:trail-trust": "node scripts/audit-trail-trust.js",
    "fetch:dolomites-trails": "node scripts/fetch-dolomites-trails.js",
    "validate:dolomites-trails": "node scripts/validate-dolomites-trails.js",
    "validate:trail-schema": "node scripts/validate-trail-schema.js",
    "validate:production-trails": "node scripts/validate-production-trails.js --report data/generated/trail-validation-report.json",
    "validate:scoring-contract": "jest --runInBand scoring-contract.test.js",
    "validate:evidence-contract": "jest --runInBand evidence-contract.test.js",
    "validate:firestore-contract": "jest --runInBand firestore-security.test.js",
    "test:firestore-rules": "node scripts/run-firestore-rules-tests.cjs",
    "check:trail-sources": "node scripts/check-trail-sources.js",
    "build:regional-data": "node scripts/build-regional-runtime-data.js",
    "build:dolomites-trails": "npm run fetch:dolomites-trails && npm run validate:dolomites-trails"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/*.test.js"
    ]
  }
}
