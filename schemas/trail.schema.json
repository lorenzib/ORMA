{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.app-orma.com/schemas/trail.schema.json",
  "title": "ORMA canonical trail record",
  "description": "Version 1 contract shared by curated and imported trails. Geographic coordinates always use GeoJSON [longitude, latitude] order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordVersion",
    "id",
    "slug",
    "origin",
    "lifecycle",
    "name",
    "region",
    "geometry",
    "center",
    "trailhead",
    "metrics",
    "suitability",
    "waypoints",
    "segments",
    "content",
    "sources",
    "verification",
    "freshness",
    "provenance",
    "unknownFields"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,99}$"
    },
    "origin": {
      "enum": [
        "curated",
        "osm"
      ]
    },
    "lifecycle": {
      "enum": [
        "draft",
        "published",
        "retired"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "region": {
      "$ref": "#/$defs/region"
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/position"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiLineString"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/position"
                }
              }
            }
          }
        }
      ]
    },
    "center": {
      "$ref": "#/$defs/position"
    },
    "trailhead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "label",
        "status"
      ],
      "properties": {
        "position": {
          "oneOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "status": {
          "enum": [
            "reviewed",
            "mapped-suggestion",
            "unknown"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distanceKm",
        "ascentM",
        "descentM",
        "durationMinutes",
        "minElevationM",
        "maxElevationM",
        "routeType",
        "difficulty"
      ],
      "properties": {
        "distanceKm": {
          "$ref": "#/$defs/nonNegativeNumberOrNull"
        },
        "ascentM": {
          "$ref": "#/$defs/nonNegativeNumberOrNull"
        },
        "descentM": {
          "$ref": "#/$defs/nonNegativeNumberOrNull"
        },
        "durationMinutes": {
          "$ref": "#/$defs/nonNegativeNumberOrNull"
        },
        "minElevationM": {
          "$ref": "#/$defs/numberOrNull"
        },
        "maxElevationM": {
          "$ref": "#/$defs/numberOrNull"
        },
        "routeType": {
          "enum": [
            "loop",
            "out-and-back",
            "point-to-point",
            "unknown"
          ]
        },
        "difficulty": {
          "enum": [
            "easy",
            "moderate",
            "hard",
            "expert",
            "unknown"
          ]
        }
      }
    },
    "suitability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safetyLevel",
        "terrainRank",
        "shadePercent",
        "heatRisk",
        "exposure",
        "surfaceHazards",
        "dogAccess",
        "livestockPresence",
        "wildlifePresence",
        "sightlines",
        "roadProximity",
        "crowding"
      ],
      "properties": {
        "safetyLevel": {
          "enum": [
            "low-risk",
            "moderate",
            "caution",
            "unknown"
          ]
        },
        "terrainRank": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "shadePercent": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "heatRisk": {
          "enum": [
            "low",
            "moderate",
            "high",
            "unknown"
          ]
        },
        "exposure": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "surfaceHazards": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uniqueItems": true
        },
        "dogAccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "notes"
          ],
          "properties": {
            "status": {
              "enum": [
                "allowed",
                "leash-required",
                "seasonal-restrictions",
                "prohibited",
                "unknown"
              ]
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            }
          }
        },
        "livestockPresence": {
          "enum": [
            "none",
            "seasonal",
            "likely",
            "unknown"
          ]
        },
        "wildlifePresence": {
          "enum": [
            "low",
            "moderate",
            "high",
            "unknown"
          ]
        },
        "sightlines": {
          "enum": [
            "open",
            "mixed",
            "restricted",
            "unknown"
          ]
        },
        "roadProximity": {
          "enum": [
            "none",
            "crossings",
            "alongside",
            "unknown"
          ]
        },
        "crowding": {
          "enum": [
            "quiet",
            "moderate",
            "busy",
            "unknown"
          ]
        }
      }
    },
    "waypoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waypoint"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "tips"
      ],
      "properties": {
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "tips": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "status",
        "reviewedAt",
        "reviewedBy",
        "categories"
      ],
      "properties": {
        "tier": {
          "enum": [
            "imported",
            "mapped",
            "route-audited",
            "field-verified"
          ]
        },
        "status": {
          "enum": [
            "unreviewed",
            "in-progress",
            "verified"
          ]
        },
        "reviewedAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "water",
            "heat",
            "exposure",
            "livestock",
            "surfaceHazards",
            "access"
          ],
          "properties": {
            "route": {
              "$ref": "#/$defs/reviewState"
            },
            "water": {
              "$ref": "#/$defs/reviewState"
            },
            "heat": {
              "$ref": "#/$defs/reviewState"
            },
            "exposure": {
              "$ref": "#/$defs/reviewState"
            },
            "livestock": {
              "$ref": "#/$defs/reviewState"
            },
            "surfaceHazards": {
              "$ref": "#/$defs/reviewState"
            },
            "access": {
              "$ref": "#/$defs/reviewState"
            }
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometryAt",
        "safetyAt",
        "accessAt"
      ],
      "properties": {
        "geometryAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "safetyAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "accessAt": {
          "$ref": "#/$defs/dateOrNull"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalId",
        "generatedAt",
        "generatorVersion"
      ],
      "properties": {
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "generatedAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "generatorVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "unknownFields": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/(metrics|trailhead|suitability|waypoints|content|sources|verification|freshness|provenance)(/[^/]+)+$"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "numberOrNull": {
      "type": [
        "number",
        "null"
      ]
    },
    "nonNegativeNumberOrNull": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "dateOrNull": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewState": {
      "enum": [
        "verified",
        "unreviewed",
        "unknown"
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "countryCode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "waypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "position",
        "distanceKm",
        "status",
        "seasonal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        },
        "type": {
          "enum": [
            "water",
            "parking",
            "trailhead",
            "shelter",
            "hazard",
            "emergency-exit",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "distanceKm": {
          "$ref": "#/$defs/nonNegativeNumberOrNull"
        },
        "status": {
          "enum": [
            "reviewed",
            "mapped",
            "unknown"
          ]
        },
        "seasonal": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "url",
        "provider",
        "kind",
        "retrievedAt",
        "observedAt",
        "categories",
        "licence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "official",
            "osm",
            "field-review",
            "computed",
            "legacy",
            "other"
          ]
        },
        "retrievedAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "observedAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "categories": {
          "type": "array",
          "items": {
            "enum": [
              "route",
              "metrics",
              "water",
              "heat",
              "exposure",
              "livestock",
              "surfaceHazards",
              "access",
              "content"
            ]
          },
          "uniqueItems": true
        },
        "licence": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "fromKm",
        "toKm",
        "advisory",
        "note",
        "status",
        "seasonal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        },
        "type": {
          "enum": [
            "livestock",
            "wildlife",
            "road",
            "exposure",
            "crowding",
            "surface",
            "water-scarce",
            "other"
          ]
        },
        "fromKm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "toKm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "advisory": {
          "enum": [
            "leash-required",
            "leash-recommended",
            "avoid",
            "caution",
            "information"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "status": {
          "enum": [
            "reviewed",
            "mapped",
            "reported",
            "unknown"
          ]
        },
        "seasonal": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
