rules_version = '2';

// SEC-01 — ORMA Firestore authorization boundary.
//
// Contributor eligibility is a verified Firebase email plus absence from the
// private operator-managed block list. Moderator privileges remain a trusted
// Firebase Authentication custom claim.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isContributor() {
      return isSignedIn()
        && request.auth.token.get('email_verified', false) == true
        && !exists(
          /databases/$(database)/documents/contributionBlocks/$(request.auth.uid)
        );
    }

    function isModerator() {
      return isSignedIn()
        && request.auth.token.get('moderator', false) == true;
    }

    function validPublicDog(dog) {
      return dog is map
        && dog.keys().hasOnly(['id', 'name', 'bio', 'photo', 'public'])
        && dog.id is string && dog.id.size() > 0 && dog.id.size() <= 80
        && dog.name is string && dog.name.size() > 0 && dog.name.size() <= 40
        && dog.bio is string && dog.bio.size() <= 180
        && dog.photo is string && dog.photo.size() <= 700000
        && dog.public is bool;
    }

    function validPublicProfile(data, uid) {
      return data.keys().hasOnly([
          'uid', 'displayName', 'bio', 'visibility', 'tagPermission', 'dogs',
          'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 40
        && data.bio is string && data.bio.size() <= 240
        && data.visibility in ['public', 'private']
        && data.tagPermission in ['everyone', 'followers', 'none']
        && data.dogs is list && data.dogs.size() <= 5
        && (data.dogs.size() < 1 || validPublicDog(data.dogs[0]))
        && (data.dogs.size() < 2 || validPublicDog(data.dogs[1]))
        && (data.dogs.size() < 3 || validPublicDog(data.dogs[2]))
        && (data.dogs.size() < 4 || validPublicDog(data.dogs[3]))
        && (data.dogs.size() < 5 || validPublicDog(data.dogs[4]))
        && data.updatedAt == request.time;
    }

    function validFollow(data) {
      return data.keys().hasOnly([
          'followerUid', 'ownerUid', 'targetType', 'targetId', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.followerUid is string && data.followerUid.size() <= 128
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && data.ownerUid != data.followerUid
        && data.targetType in ['human', 'dog']
        && data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 80
        && data.status in ['accepted', 'pending']
        && data.updatedAt == request.time;
    }

    function isShortString(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function isTrailId(value) {
      return isShortString(value, 80)
        && value.matches('^[A-Za-z0-9._-]+$');
    }

    function isOptionalString(data, field, maximum) {
      return !data.keys().hasAny([field])
        || data.get(field, null) == null
        || (data.get(field, null) is string
          && data.get(field, '').size() <= maximum);
    }

    function validDogContext(data, allowBreed) {
      return data == null
        || (data is map
          && data.keys().hasOnly(allowBreed ? ['name', 'breed'] : ['name'])
          && isOptionalString(data, 'name', 40)
          && (!allowBreed || isOptionalString(data, 'breed', 240)));
    }

    // Vet/owner keep only the key allowlist. Firestore evaluates at most
    // 1,000 rule expressions per request, and validDog runs up to six times
    // per user-doc write (five dogs plus the compatibility mirror); the
    // per-field length checks pushed multi-dog writes over that limit and
    // Firestore denied them. Key restriction plus the 1 MiB document cap
    // bound these values well enough.
    function validVet(data) {
      return data is map
        && data.keys().hasOnly(['name', 'phone', 'chip', 'insurer', 'policy']);
    }

    function validOwner(data) {
      return data is map
        && data.keys().hasOnly(['name', 'phone', 'email', 'emName', 'emPhone']);
    }

    function validDog(data) {
      // Dog profiles are private owner data. Validation stays deliberately
      // cheap: this function runs up to six times per user-doc write (five
      // dogs plus the compatibility mirror) inside Firestore's hard limit of
      // 1,000 rule expressions per request — the previous per-field checks
      // exceeded it and every multi-dog save was denied. Keep the map size,
      // fitness enum, photo size, and nested contact allowlists; the 1 MiB
      // document cap bounds everything else.
      return data == null
        || (data is map
          && data.size() <= 25
          && (data.get('name', null) == null
            || (data.name is string && data.name.size() <= 40))
          && (data.get('fitness', null) == null
            || data.fitness in ['low', 'moderate', 'high'])
          // No regex on the photo: matches() over a ~40 KB data URI costs
          // hundreds of rule expressions and blew the budget across five
          // dogs. Type + size bounds here; the client enforces the
          // data:image/ prefix before upload.
          && (data.get('photo', null) == null
            || (data.photo is string && data.photo.size() <= 700000))
          && (data.get('vet', null) == null || validVet(data.vet))
          && (data.get('owner', null) == null || validOwner(data.owner)));
    }

    function validDogs(data) {
      return data is list
        && data.size() <= 5
        && (data.size() < 1 || validDog(data[0]))
        && (data.size() < 2 || validDog(data[1]))
        && (data.size() < 3 || validDog(data[2]))
        && (data.size() < 4 || validDog(data[3]))
        && (data.size() < 5 || validDog(data[4]));
    }

    function validUserDocument(data) {
      return data.keys().hasOnly([
          'favorites', 'dog', 'dogs', 'activeDogId', 'lastMatches', 'createdAt', 'updatedAt',
          'notifSeen', 'notifSeenAt'
        ])
        && (!data.keys().hasAny(['notifSeen'])
          || (data.notifSeen is list && data.notifSeen.size() <= 300))
        && (!data.keys().hasAny(['notifSeenAt'])
          || data.notifSeenAt is timestamp)
        && (!data.keys().hasAny(['favorites'])
          || (data.favorites is map && data.favorites.size() <= 250))
        && (!data.keys().hasAny(['dog'])
          || validDog(data.dog))
        && (!data.keys().hasAny(['dogs'])
          || validDogs(data.dogs))
        && isOptionalString(data, 'activeDogId', 80)
        && (!data.keys().hasAny(['lastMatches'])
          || (data.lastMatches is list && data.lastMatches.size() <= 250))
        && (!data.keys().hasAny(['createdAt'])
          || data.createdAt is timestamp)
        && (!data.keys().hasAny(['updatedAt'])
          || data.updatedAt is timestamp);
    }

    function validModerationMetadata(data) {
      return (!data.keys().hasAny(['moderatedAt'])
          || data.moderatedAt is timestamp)
        && (!data.keys().hasAny(['moderatedBy'])
          || isShortString(data.moderatedBy, 128));
    }

    function isCommunityState(status) {
      return status in ['pending', 'visible', 'reported', 'hidden', 'removed'];
    }

    function hazardMaximumLifetime(type) {
      return type == 'water-dry' ? duration.value(7, 'd')
        : type == 'guard-dogs-livestock' ? duration.value(14, 'd')
        : type == 'not-dog-friendly' ? duration.value(90, 'd')
        : duration.value(30, 'd');
    }

    function validHazardLifecycle(data) {
      return (!data.keys().hasAny(['confirmationSource'])
          || data.confirmationSource in [
            'community', 'dolopaws-reviewed', 'official'
          ])
        && (!data.keys().hasAny(['confirmations'])
          || (data.confirmations is int
            && data.confirmations >= 0 && data.confirmations <= 100000))
        && (!data.keys().hasAny(['disputes'])
          || (data.disputes is int
            && data.disputes >= 0 && data.disputes <= 100000))
        && (!data.keys().hasAny(['expiresAt'])
          || data.expiresAt is timestamp)
        && (!data.keys().hasAny(['lastCommunityResponseAt'])
          || data.lastCommunityResponseAt is timestamp)
        && (!data.keys().hasAny(['confirmedAt'])
          || data.confirmedAt is timestamp)
        && isOptionalString(data, 'confirmedBy', 128);
    }

    function validNewHazardLifecycle(data) {
      return data.keys().hasAll([
          'confirmationSource', 'confirmations', 'disputes', 'expiresAt'
        ])
        && data.confirmationSource == 'community'
        && data.confirmations == 0
        && data.disputes == 0
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + hazardMaximumLifetime(data.type)
        && !data.keys().hasAny([
          'lastCommunityResponseAt', 'confirmedAt', 'confirmedBy'
        ]);
    }

    function validFlag(data) {
      return data.keys().hasOnly([
          'trailId', 'uid', 'type', 'km', 'text', 'dogContext', 'status',
          'createdAt', 'moderatedAt', 'moderatedBy', 'confirmationSource',
          'confirmations', 'disputes', 'expiresAt',
          'lastCommunityResponseAt', 'confirmedAt', 'confirmedBy'
        ])
        && isTrailId(data.trailId)
        && isShortString(data.uid, 128)
        && data.type in [
          'guard-dogs-livestock', 'dangerous-terrain', 'not-dog-friendly',
          'water-dry', 'lift-refused-dog', 'other'
        ]
        && (data.km == null || (data.km is number && data.km >= 0 && data.km <= 100))
        && data.text is string && data.text.size() <= 300
        && validDogContext(data.dogContext, true)
        && isCommunityState(data.status)
        && data.createdAt is timestamp
        && validModerationMetadata(data)
        && validHazardLifecycle(data);
    }

    function validReview(data) {
      return data.keys().hasOnly([
          'trailId', 'uid', 'rating', 'text', 'dogContext', 'hikedOn',
          'status', 'createdAt', 'moderatedAt', 'moderatedBy'
        ])
        && isTrailId(data.trailId)
        && isShortString(data.uid, 128)
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.text is string && data.text.size() <= 1000
        && validDogContext(data.dogContext, true)
        && (data.hikedOn == null || isShortString(data.hikedOn, 10))
        && isCommunityState(data.status)
        && data.createdAt is timestamp
        && validModerationMetadata(data);
    }

    function validPhoto(data) {
      return data.keys().hasOnly([
          'trailId', 'uid', 'image', 'caption', 'dogContext', 'status',
          'createdAt', 'moderatedAt', 'moderatedBy'
        ])
        && isTrailId(data.trailId)
        && isShortString(data.uid, 128)
        && data.image is string
        && data.image.matches('^data:image/(jpeg|jpg|png|webp);base64,.*$')
        && data.image.size() <= 700000
        && data.caption is string && data.caption.size() <= 240
        && validDogContext(data.dogContext, false)
        && isCommunityState(data.status)
        && data.createdAt is timestamp
        && validModerationMetadata(data);
    }

    function validPlaceDogReport(data) {
      return data.keys().hasOnly([
          'placeId', 'placeName', 'placeType', 'coordinates', 'uid',
          'policy', 'evidence', 'note', 'status', 'createdAt',
          'moderatedAt', 'moderatedBy'
        ])
        && isShortString(data.placeId, 120)
        && isShortString(data.placeName, 120)
        && isShortString(data.placeType, 40)
        && data.coordinates is map
        && data.coordinates.keys().hasOnly(['lng', 'lat'])
        && data.coordinates.lng is number
        && data.coordinates.lng >= -180 && data.coordinates.lng <= 180
        && data.coordinates.lat is number
        && data.coordinates.lat >= -90 && data.coordinates.lat <= 90
        && isShortString(data.uid, 128)
        && data.policy in ['welcome', 'leashed', 'not-allowed']
        && data.evidence in ['visited', 'staff-confirmed', 'posted-sign']
        && data.note is string && data.note.size() <= 300
        && isCommunityState(data.status)
        && data.createdAt is timestamp
        && validModerationMetadata(data);
    }

    function moderatorPlaceDogReportUpdate() {
      return isModerator()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.placeId == resource.data.placeId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'moderatedAt', 'moderatedBy'])
        && validModeratorTransition(resource.data.status, request.resource.data.status)
        && request.resource.data.moderatedAt == request.time
        && request.resource.data.moderatedBy == request.auth.uid;
    }

    function validPrivateOutcome(data, outcomeId) {
      return data.keys().hasAll([
          'schemaVersion', 'outcomeId', 'completionId', 'trailId', 'response',
          'waterAccuracy', 'hazards', 'recordedHikePresent',
          'offlinePackageUsed', 'createdAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'outcomeId', 'completionId', 'trailId', 'response',
          'waterAccuracy', 'hazards', 'recordedHikePresent',
          'offlinePackageUsed', 'createdAt'
        ])
        && data.schemaVersion == 1
        && isShortString(data.outcomeId, 200)
        && data.outcomeId == outcomeId
        && isShortString(data.completionId, 180)
        && isTrailId(data.trailId)
        && data.response in [
          'appropriate', 'appropriate_with_unexpected_cautions',
          'not_appropriate', 'did_not_complete', 'prefer_not_to_answer'
        ]
        && (data.waterAccuracy == null || data.waterAccuracy in [
          'accurate', 'less_than_listed', 'more_than_listed', 'not_checked'
        ])
        && data.hazards is list
        && data.hazards.size() <= 6
        && data.hazards.hasOnly([
          'surface', 'exposure', 'livestock', 'heat', 'access', 'water'
        ])
        && data.recordedHikePresent is bool
        && data.offlinePackageUsed is bool
        && data.createdAt is timestamp;
    }

    function validModerationAudit(data) {
      return data.keys().hasAll([
          'contentType', 'contentId', 'targetId', 'authorUid', 'fromStatus',
          'toStatus', 'moderatorUid', 'reason', 'createdAt'
        ])
        && data.keys().hasOnly([
          'contentType', 'contentId', 'targetId', 'trailId', 'authorUid', 'fromStatus',
          'toStatus', 'moderatorUid', 'reason', 'createdAt'
        ])
        && data.contentType in ['flag', 'review', 'photo', 'placeDog']
        && isShortString(data.contentId, 100)
        && isShortString(data.targetId, 120)
        && (!data.keys().hasAny(['trailId']) || isTrailId(data.trailId))
        && isShortString(data.authorUid, 128)
        && isCommunityState(data.fromStatus)
        && isCommunityState(data.toStatus)
        && isShortString(data.moderatorUid, 128)
        && data.reason is string && data.reason.size() <= 300
        && data.createdAt is timestamp;
    }

    function ownerContentUpdate() {
      return isContributor()
        && isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.trailId == resource.data.trailId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == resource.data.createdAt
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['moderatedAt', 'moderatedBy']);
    }

    function validModeratorTransition(from, to) {
      return (from == 'pending' && to in ['visible', 'hidden', 'removed'])
        || (from == 'visible' && to in ['reported', 'hidden', 'removed'])
        || (from == 'reported' && to in ['visible', 'hidden', 'removed'])
        || (from == 'hidden' && to in ['visible', 'removed'])
        || (from == 'removed' && to == 'visible');
    }

    function moderatorStateUpdate() {
      return isModerator()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.trailId == resource.data.trailId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'moderatedAt', 'moderatedBy'])
        && validModeratorTransition(
          resource.data.status,
          request.resource.data.status
        )
        && request.resource.data.moderatedAt == request.time
        && request.resource.data.moderatedBy == request.auth.uid;
    }

    function ownerFlagContentUpdate() {
      return ownerContentUpdate()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'confirmationSource', 'confirmations', 'disputes', 'expiresAt',
          'lastCommunityResponseAt', 'confirmedAt', 'confirmedBy'
        ]);
    }

    function moderatorFlagUpdate() {
      return isModerator()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.trailId == resource.data.trailId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'moderatedAt', 'moderatedBy', 'confirmationSource',
          'confirmations', 'disputes', 'confirmedAt', 'confirmedBy',
          'expiresAt'
        ])
        && (
          validModeratorTransition(
            resource.data.status,
            request.resource.data.status
          )
          || (
            resource.data.status == request.resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'confirmationSource', 'confirmations', 'disputes',
              'confirmedAt', 'confirmedBy', 'expiresAt'
            ])
          )
        )
        && request.resource.data.moderatedAt == request.time
        && request.resource.data.moderatedBy == request.auth.uid
        && (
          (
            request.resource.data.get('confirmationSource', 'community')
              == resource.data.get('confirmationSource', 'community')
            && request.resource.data.get('confirmedAt', null)
              == resource.data.get('confirmedAt', null)
            && request.resource.data.get('confirmedBy', null)
              == resource.data.get('confirmedBy', null)
            && request.resource.data.get('expiresAt', null)
              == resource.data.get('expiresAt', null)
            && request.resource.data.get('confirmations', 0)
              == resource.data.get('confirmations', 0)
            && request.resource.data.get('disputes', 0)
              == resource.data.get('disputes', 0)
          )
          || (
            request.resource.data.confirmationSource in [
              'dolopaws-reviewed', 'official'
            ]
            && request.resource.data.confirmedAt == request.time
            && request.resource.data.confirmedBy == request.auth.uid
            && request.resource.data.get('confirmations', 0)
              == resource.data.get('confirmations', 0)
            && request.resource.data.get('disputes', 0)
              == resource.data.get('disputes', 0)
            && request.resource.data.expiresAt > request.time
            && request.resource.data.expiresAt
              <= request.time + hazardMaximumLifetime(request.resource.data.type)
          )
          || (
            request.resource.data.confirmationSource == 'community'
            && request.resource.data.confirmations
              == resource.data.get('confirmations', 0)
            && request.resource.data.disputes
              == resource.data.get('disputes', 0)
            && request.resource.data.get('confirmedAt', null)
              == resource.data.get('confirmedAt', null)
            && request.resource.data.get('confirmedBy', null)
              == resource.data.get('confirmedBy', null)
            && request.resource.data.expiresAt > request.time
            && request.resource.data.expiresAt
              <= request.time + hazardMaximumLifetime(request.resource.data.type)
          )
        );
    }

    function validHazardResponse(data, flagId, uid) {
      return data.keys().hasAll(['flagId', 'uid', 'stance', 'createdAt'])
        && data.keys().hasOnly(['flagId', 'uid', 'stance', 'createdAt'])
        && data.flagId == flagId
        && data.uid == uid
        && data.stance in ['confirm', 'dispute']
        && data.createdAt == request.time;
    }

    function communityFlagResponseUpdate(flagId) {
      return isContributor()
        && resource.data.status in ['visible', 'reported']
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
        && resource.data.uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'confirmations', 'disputes', 'lastCommunityResponseAt'
        ])
        && request.resource.data.lastCommunityResponseAt == request.time
        && !exists(
          /databases/$(database)/documents/flags/$(flagId)/responses/$(request.auth.uid)
        )
        && existsAfter(
          /databases/$(database)/documents/flags/$(flagId)/responses/$(request.auth.uid)
        )
        && (
          (
            getAfter(
              /databases/$(database)/documents/flags/$(flagId)/responses/$(request.auth.uid)
            ).data.stance == 'confirm'
            && request.resource.data.confirmations
              == resource.data.confirmations + 1
            && request.resource.data.disputes == resource.data.disputes
          )
          || (
            getAfter(
              /databases/$(database)/documents/flags/$(flagId)/responses/$(request.auth.uid)
            ).data.stance == 'dispute'
            && request.resource.data.disputes == resource.data.disputes + 1
            && request.resource.data.confirmations == resource.data.confirmations
          )
        );
    }

    // One private document per account. Public contribution privileges are
    // deliberately absent from this schema and cannot be self-assigned here.
    match /users/{uid} {
      allow get, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validUserDocument(request.resource.data);
      allow list: if false;
    }

    // Public identities are an explicit, tightly allowlisted projection of a
    // member profile. Contact, health, vet, journal and location fields cannot
    // be written here. A private profile remains visible by direct URL so a
    // follow request can be made, but its page suppresses bio and activity.
    match /publicProfiles/{uid} {
      allow get: if true;
      allow list: if resource.data.visibility == 'public';
      allow create, update: if isOwner(uid)
        && validPublicProfile(request.resource.data, uid);
      allow delete: if isOwner(uid);
    }

    // Follow edges never contain contact data. The follower may create or
    // remove an edge; the target owner alone may approve a private request.
    match /follows/{edgeId} {
      allow get: if isSignedIn()
        && (resource.data.followerUid == request.auth.uid
          || resource.data.ownerUid == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.followerUid == request.auth.uid
          || resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.followerUid == request.auth.uid
        && validFollow(request.resource.data)
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.ownerUid))
        && (
          (get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.ownerUid)).data.visibility == 'public'
            && request.resource.data.status == 'accepted')
          ||
          (get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.ownerUid)).data.visibility == 'private'
            && request.resource.data.status in ['pending'])
        )
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSignedIn()
        && (resource.data.followerUid == request.auth.uid
          || resource.data.ownerUid == request.auth.uid);
    }

    // Structured suitability outcomes are private owner data, not reviews.
    // A deterministic completion-bound ID makes create retries idempotent.
    match /users/{uid}/outcomes/{outcomeId} {
      allow get, list, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && validPrivateOutcome(request.resource.data, outcomeId)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // Operators create and remove block records in the Firebase console.
    // Application clients cannot inspect or modify this private list.
    match /contributionBlocks/{uid} {
      allow read, write: if false;
    }

    // Site notices power the notification centre's broadcast items (new
    // trails, safety advisories, product news). Operators write them from
    // the moderation workspace; everyone may read. Immutable once posted —
    // corrections are a delete plus a new notice.
    match /siteNotices/{noticeId} {
      allow read: if true;
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'href', 'type', 'createdAt', 'expiresAt'
        ])
        && isShortString(request.resource.data.title, 80)
        && isShortString(request.resource.data.body, 280)
        && (request.resource.data.get('href', null) == null
          || (request.resource.data.href is string
            && request.resource.data.href.size() <= 200
            && !request.resource.data.href.matches('^[a-zA-Z]+:.*$')))
        && request.resource.data.type in ['news', 'trail', 'safety']
        && request.resource.data.createdAt == request.time
        && (request.resource.data.get('expiresAt', null) == null
          || request.resource.data.expiresAt is timestamp);
      allow update: if false;
      allow delete: if isModerator();
    }

    // Anonymous, identity-free usage counter. The write contains only a
    // server timestamp; precise location and account identity are prohibited.
    match /hikeEvents/{trailId}/events/{eventId} {
      allow create: if isTrailId(trailId)
        && request.resource.data.keys().hasOnly(['startedAt'])
        && request.resource.data.startedAt == request.time;
      allow read: if true;
      allow update: if false;
      allow delete: if isModerator();
    }

    match /flags/{flagId} {
      allow get: if isModerator()
        || isOwner(resource.data.uid)
        || (
          resource.data.status in ['visible', 'reported']
          && resource.data.expiresAt is timestamp
          && resource.data.expiresAt > request.time
        );
      allow list: if isModerator()
        || resource.data.status in ['visible', 'reported'];
      allow create: if isContributor()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(['moderatedAt', 'moderatedBy'])
        && validNewHazardLifecycle(request.resource.data)
        && validFlag(request.resource.data);
      allow update: if validFlag(request.resource.data)
        && (
          ownerFlagContentUpdate()
          || moderatorFlagUpdate()
          || communityFlagResponseUpdate(flagId)
        );
      allow delete: if isOwner(resource.data.uid) || isModerator();

      match /responses/{uid} {
        allow get: if isModerator() || isOwner(uid);
        allow list: if isModerator();
        allow create: if isContributor()
          && request.auth.uid == uid
          && validHazardResponse(request.resource.data, flagId, uid)
          && get(
            /databases/$(database)/documents/flags/$(flagId)
          ).data.status in ['visible', 'reported']
          && get(
            /databases/$(database)/documents/flags/$(flagId)
          ).data.expiresAt > request.time
          && get(
            /databases/$(database)/documents/flags/$(flagId)
          ).data.uid != request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /reviews/{reviewId} {
      allow get: if isModerator()
        || isOwner(resource.data.uid)
        || resource.data.status in ['visible', 'reported'];
      allow list: if isModerator()
        || resource.data.status in ['visible', 'reported'];
      allow create: if isContributor()
        && request.resource.data.uid == request.auth.uid
        && reviewId == request.resource.data.trailId + '_' + request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(['moderatedAt', 'moderatedBy'])
        && validReview(request.resource.data);
      allow update: if reviewId == resource.data.trailId + '_' + resource.data.uid
        && validReview(request.resource.data)
        && (ownerContentUpdate() || moderatorStateUpdate());
      allow delete: if isOwner(resource.data.uid) || isModerator();
    }

    match /trailPhotos/{photoId} {
      allow get: if isModerator()
        || isOwner(resource.data.uid)
        || resource.data.status in ['visible', 'reported'];
      allow list: if isModerator()
        || resource.data.status in ['visible', 'reported'];
      allow create: if isContributor()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(['moderatedAt', 'moderatedBy'])
        && validPhoto(request.resource.data);
      allow update: if validPhoto(request.resource.data)
        && (ownerContentUpdate() || moderatorStateUpdate());
      allow delete: if isOwner(resource.data.uid) || isModerator();
    }

    // First-hand place observations remain pending until an ORMA moderator
    // reviews them. Only visible/reported records may power public badges.
    match /placeDogReports/{reportId} {
      allow get: if isModerator()
        || isOwner(resource.data.uid)
        || resource.data.status in ['visible', 'reported'];
      allow list: if isModerator()
        || resource.data.status in ['visible', 'reported'];
      allow create: if isContributor()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(['moderatedAt', 'moderatedBy'])
        && validPlaceDogReport(request.resource.data);
      allow update: if validPlaceDogReport(request.resource.data)
        && moderatorPlaceDogReportUpdate();
      allow delete: if isOwner(resource.data.uid) || isModerator();
    }

    // Immutable operator decisions. Audit records contain contribution IDs
    // and moderation metadata only, never account profiles or email addresses.
    match /moderationAudit/{auditId} {
      allow get, list: if isModerator();
      allow create: if isModerator()
        && validModerationAudit(request.resource.data)
        && request.resource.data.moderatorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Abuse reports are private moderation inputs, never public content.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'targetType', 'targetId', 'uid', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetType in ['flag', 'review', 'photo']
        && isShortString(request.resource.data.targetId, 100)
        && isShortString(request.resource.data.reason, 200)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow get: if isModerator() || isOwner(resource.data.uid);
      allow list: if isModerator();
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.status in [
          'open', 'reviewed', 'dismissed', 'actioned'
        ]
        && request.resource.data.resolvedAt is timestamp
        && request.resource.data.resolvedBy == request.auth.uid;
      allow delete: if isModerator();
    }

    // Private ORMA agent backoffice. Browser clients may inspect state and
    // append immutable human decisions only when carrying the moderator
    // custom claim. Artifacts and jobs are mutated exclusively by the Admin
    // SDK worker, which is outside client-rule evaluation.
    match /backofficeArtifacts/{artifactId} {
      allow get, list: if isModerator();
      allow create, update, delete: if false;
    }

    match /backofficeJobs/{jobId} {
      allow get, list: if isModerator();
      allow create, update, delete: if false;
    }

    match /backofficeReviews/{reviewId} {
      allow get, list: if isModerator();
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'contractVersion', 'type', 'gate', 'status', 'decisions',
          'submittedAt', 'submittedBy', 'publicMutationAllowed'
        ])
        && request.resource.data.contractVersion == '1.0.0'
        && request.resource.data.type == 'verified-trail-content-review'
        && request.resource.data.gate == 'content-review'
        && request.resource.data.status == 'queued'
        && request.resource.data.decisions is list
        && request.resource.data.decisions.size() > 0
        && request.resource.data.decisions.size() <= 50
        && request.resource.data.submittedAt == request.time
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publicMutationAllowed == false;
      allow update, delete: if false;
    }

    match /backofficePublicationReviews/{reviewId} {
      allow get, list: if isModerator();
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'contractVersion', 'type', 'status', 'candidateId', 'action',
          'note', 'submittedAt', 'submittedBy', 'publicMutationAllowed'
        ])
        && request.resource.data.contractVersion == '1.0.0'
        && request.resource.data.type == 'verified-trail-publication-review'
        && request.resource.data.status == 'queued'
        && isTrailId(request.resource.data.candidateId)
        && request.resource.data.action in [
          'approve-for-pr-creation', 'request-changes', 'hold'
        ]
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1500
        && request.resource.data.submittedAt == request.time
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publicMutationAllowed == false;
      allow update, delete: if false;
    }

    match /backofficeDossierReviews/{reviewId} {
      allow get, list: if isModerator();
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'contractVersion', 'type', 'status', 'reviewId', 'candidateId',
          'action', 'targetAgent', 'note', 'submittedAt', 'submittedBy',
          'publicMutationAllowed'
        ])
        && request.resource.data.contractVersion == '1.0.0'
        && request.resource.data.type == 'trail-dossier-review'
        && request.resource.data.status == 'queued'
        && isShortString(request.resource.data.reviewId, 180)
        && isTrailId(request.resource.data.candidateId)
        && request.resource.data.action in ['approve', 'request-revision', 'reject']
        && request.resource.data.targetAgent is string
        && request.resource.data.targetAgent.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1500
        && request.resource.data.submittedAt == request.time
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publicMutationAllowed == false;
      allow update, delete: if false;
    }

    match /backofficeNewTrailReviews/{reviewId} {
      allow get, list: if isModerator();
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'contractVersion', 'type', 'status', 'candidateId', 'action',
          'note', 'submittedAt', 'submittedBy', 'publicMutationAllowed'
        ])
        && request.resource.data.contractVersion == '1.0.0'
        && request.resource.data.type == 'new-trail-selection'
        && request.resource.data.status == 'queued'
        && isShortString(request.resource.data.candidateId, 160)
        && request.resource.data.action in ['send-to-verification', 'park', 'reject']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1200
        && request.resource.data.submittedAt == request.time
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publicMutationAllowed == false;
      allow update, delete: if false;
    }

    match /backofficeHazardReviews/{reviewId} {
      allow get, list: if isModerator();
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'contractVersion', 'type', 'status', 'hazardId', 'action',
          'note', 'submittedAt', 'submittedBy', 'publicMutationAllowed'
        ])
        && request.resource.data.contractVersion == '1.0.0'
        && request.resource.data.type == 'hazard-resolution-review'
        && request.resource.data.status == 'queued'
        && isShortString(request.resource.data.hazardId, 240)
        && request.resource.data.action in ['confirm-resolved', 'keep-active']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.submittedAt == request.time
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publicMutationAllowed == false;
      allow update, delete: if false;
    }

    match /backofficeEditorialReviews/{reviewId} {
      allow get, list: if isModerator();
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'contractVersion', 'type', 'status', 'packetGeneratedAt',
          'sourceRef', 'action', 'note', 'edits', 'submittedAt',
          'submittedBy', 'publicMutationAllowed'
        ])
        && request.resource.data.contractVersion == '1.0.0'
        && request.resource.data.type == 'website-editorial-review'
        && request.resource.data.status == 'queued'
        && isShortString(request.resource.data.packetGeneratedAt, 80)
        && isShortString(request.resource.data.sourceRef, 300)
        && request.resource.data.action in ['approve', 'request-revision']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1500
        && request.resource.data.edits is list
        && request.resource.data.edits.size() <= 20
        && request.resource.data.submittedAt == request.time
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publicMutationAllowed == false;
      allow update, delete: if false;
    }

    match /backofficeImageReviews/{reviewId} {
      allow get, list: if isModerator();
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'contractVersion', 'type', 'status', 'slug', 'trailId', 'action', 'note',
          'assetRef', 'uploadRef', 'fileName', 'mimeType', 'fileSize',
          'width', 'height', 'creator', 'rightsBasis', 'altText',
          'sourcePageUrl', 'license', 'licenseUrl', 'sourceType',
          'submittedAt', 'submittedBy', 'publicMutationAllowed'
        ])
        && request.resource.data.contractVersion == '2.1.0'
        && request.resource.data.type == 'image-coverage-review'
        && request.resource.data.status == 'queued'
        && isShortString(request.resource.data.slug, 180)
        && isShortString(request.resource.data.trailId, 180)
        && request.resource.data.action in [
          'use-orma-library', 'upload-owner-photo', 'approve-uploaded-photo', 'approve-image-candidate',
          'find-licensed', 'generate-ai', 'park'
        ]
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1500
        && request.resource.data.assetRef is string
        && request.resource.data.assetRef.size() <= 1000
        && request.resource.data.uploadRef is string
        && request.resource.data.uploadRef.size() <= 1000
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 240
        && request.resource.data.mimeType is string
        && request.resource.data.mimeType.size() <= 120
        && request.resource.data.fileSize is number
        && request.resource.data.fileSize >= 0
        && request.resource.data.fileSize <= 573440
        && request.resource.data.width is number
        && request.resource.data.width >= 0
        && request.resource.data.width <= 12000
        && request.resource.data.height is number
        && request.resource.data.height >= 0
        && request.resource.data.height <= 12000
        && request.resource.data.creator is string
        && request.resource.data.creator.size() <= 160
        && request.resource.data.rightsBasis in ['', 'orma-owned', 'permission-granted', 'licensed']
        && request.resource.data.altText is string
        && request.resource.data.altText.size() <= 500
        && request.resource.data.sourcePageUrl is string
        && request.resource.data.sourcePageUrl.size() <= 1000
        && request.resource.data.license is string
        && request.resource.data.license.size() <= 160
        && request.resource.data.licenseUrl is string
        && request.resource.data.licenseUrl.size() <= 1000
        && request.resource.data.sourceType is string
        && request.resource.data.sourceType.size() <= 80
        && (
          !(request.resource.data.action in ['upload-owner-photo', 'approve-uploaded-photo'])
          || request.resource.data.uploadRef.matches('^backofficeImageUploads/[A-Za-z0-9_-]+$')
        )
        && (
          request.resource.data.action != 'approve-image-candidate'
          || request.resource.data.assetRef.matches('^(images/|https://).+')
        )
        && request.resource.data.submittedAt == request.time
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publicMutationAllowed == false;
      allow update, delete: if false;
    }

    match /backofficeImageUploads/{uploadId} {
      allow get: if isModerator();
      allow list: if false;
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'contractVersion', 'type', 'trailId', 'fileName', 'mimeType',
          'fileSize', 'width', 'height', 'uploadData', 'uploadedAt',
          'uploadedBy', 'publicMutationAllowed'
        ])
        && request.resource.data.contractVersion == '1.0.0'
        && request.resource.data.type == 'trail-image-upload'
        && isShortString(request.resource.data.trailId, 180)
        && isShortString(request.resource.data.fileName, 240)
        && request.resource.data.mimeType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.data.fileSize is number
        && request.resource.data.fileSize > 0
        && request.resource.data.fileSize <= 573440
        && request.resource.data.width is number
        && request.resource.data.width > 0
        && request.resource.data.width <= 1600
        && request.resource.data.height is number
        && request.resource.data.height > 0
        && request.resource.data.height <= 1600
        && request.resource.data.uploadData is string
        && request.resource.data.uploadData.size() <= 800000
        && request.resource.data.uploadData.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.uploadedAt == request.time
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.publicMutationAllowed == false;
      allow update: if false;
      allow delete: if isModerator() && resource.data.uploadedBy == request.auth.uid;
    }

    match /backofficeNewsletterReviews/{reviewId} {
      allow get, list: if isModerator();
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'contractVersion', 'type', 'status', 'packetGeneratedAt',
          'action', 'note', 'submittedAt', 'submittedBy',
          'publicMutationAllowed'
        ])
        && request.resource.data.contractVersion == '1.0.0'
        && request.resource.data.type == 'newsletter-issue-review'
        && request.resource.data.status == 'queued'
        && isShortString(request.resource.data.packetGeneratedAt, 80)
        && request.resource.data.action in ['approve', 'request-revision']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1500
        && request.resource.data.submittedAt == request.time
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publicMutationAllowed == false;
      allow update, delete: if false;
    }

    match /backofficeAnalystReviews/{reviewId} {
      allow get, list: if isModerator();
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly([
          'contractVersion', 'type', 'status', 'subjectType', 'ideaId',
          'action', 'note', 'submittedAt', 'submittedBy',
          'publicMutationAllowed', 'implementationAuthorized'
        ])
        && request.resource.data.contractVersion == '1.0.0'
        && request.resource.data.type == 'analyst-opportunity-review'
        && request.resource.data.status == 'queued'
        && request.resource.data.subjectType in ['idea', 'mockup']
        && isShortString(request.resource.data.ideaId, 180)
        && ((request.resource.data.subjectType == 'idea'
            && request.resource.data.action in [
              'prioritise', 'investigate-further', 'park', 'dismiss'
            ])
          || (request.resource.data.subjectType == 'mockup'
            && request.resource.data.action in [
              'approve-mockup-for-developer-brief',
              'request-mockup-revision', 'reject-mockup'
            ]))
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1500
        && request.resource.data.submittedAt == request.time
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publicMutationAllowed == false
        && request.resource.data.implementationAuthorized == false;
      allow update, delete: if false;
    }

    // New collections are private until their authorization contract is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
